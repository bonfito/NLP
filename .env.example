# --- LLM --- (ollama | anthropic | openai)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=...        # solo per server compatibili OpenAI
#
# Esempio gratuito (Groq, senza carta; verificare limiti e nome modello nella console del provider):
# LLM_PROVIDER=openai
# LLM_MODEL=llama-3.3-70b-versatile
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=la_chiave_ottenuta_da_console.groq.com

# --- Embeddings (multilingua: slide in inglese, domande in italiano) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Percorsi ---
RAW_DIR=data/raw
INDEX_DIR=data/index
COURSE_MAP=data/course_map.yaml

# --- Agente ---
TOP_K=6
MAX_REVISIONS=2
