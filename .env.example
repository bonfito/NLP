# --- LLM --- (ollama | anthropic | openai)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=...        # solo per server compatibili OpenAI
#
# Esempio gratuito (Groq, senza carta; verificare limiti e nome modello nella console del provider):
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-oss-120b      # sul piano gratuito Groq i modelli disponibili dipendono dall'account
# LLM_REASONING_EFFORT=low
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=la_chiave_ottenuta_da_console.groq.com

# --- Embeddings (multilingua: slide in inglese, domande in italiano) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Percorsi ---
RAW_DIR=data/raw
INDEX_DIR=data/index
COURSE_MAP=data/course_map.yaml

# --- Agente ---
TOP_K=6
MAX_REVISIONS=2

# Solo per modelli "thinking" (es. qwen3.5): ragionamento spento di default (molto più veloce su CPU)
# LLM_THINKING=false
# LLM_NUM_CTX=8192   # contesto di Ollama (default 4096); NLP_DEBUG=1 stampa i tempi di ogni chiamata
